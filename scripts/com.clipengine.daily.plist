<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  17:00 IST: campaign check (keep 5 live) + cut + quota top-up to exactly 5 clips per campaign. 19:30 fires again
  only if the 17:00 run is not still going: it tops up whatever is short, otherwise does nothing.
  Install:  ./scripts/install_schedule.sh      Remove: launchctl unload ~/Library/LaunchAgents/com.clipengine.daily.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.clipengine.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/Library/Application Support/clipengine/job.sh</string>
    <string>daily</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/clipengine/daily.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/clipengine/daily.log</string>
</dict>
</plist>
