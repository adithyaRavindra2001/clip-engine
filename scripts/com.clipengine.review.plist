<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the review page running at http://localhost:8765 across reboots. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.clipengine.review</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/Library/Application Support/clipengine/job.sh</string>
    <string>review</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/clipengine/review.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/clipengine/review.log</string>
</dict>
</plist>
